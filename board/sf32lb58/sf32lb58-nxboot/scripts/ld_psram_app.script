/****************************************************************************
 * board/sf32lb58-nxboot/scripts/ld_psram_app.script
 *
 * Linker script for the APPLICATION firmware that runs from PSRAM.
 * Used when the application is loaded by nxboot from NAND to PSRAM.
 *
 * Key differences from the flash linker script:
 *   - .vectors and .text go to psram (0x60400000) instead of rom (0x10000000)
 *   - .data and .ramfunc LMA is in psram (startup copies PSRAM→SRAM)
 *   - .retm_data stays in retention_ram (LMA in psram)
 *   - .bss stays in sram (zeroed by startup)
 *
 * Memory map:
 *   psram (code): 0x60400000, 16 MB
 *   sram (data):  0x20000000, 1536 KB
 *   retention_ram: 0x20000000 (first 64 KB, but actually 0x00020000 on SF32LB58)
 *
 * IMPORTANT: The nxboot bootloader writes a handoff flag (0x5053524d) to
 * retention RAM at 0x20001FF0 before jumping to this image. The chip-level
 * bsp_psramc_init() checks this flag and skips PSRAM re-initialization
 * to avoid destroying the image that was just copied from NAND.
 ****************************************************************************/

MEMORY
{
  sram (rwx)  : ORIGIN = 0x20000000, LENGTH = 1536K
  retention_ram (rw) : ORIGIN = 0x00020000, LENGTH = 64K
  psram (rwx) : ORIGIN = 0x60400000, LENGTH = 16M
}

OUTPUT_ARCH(arm)
EXTERN(_vectors)
__Vectors = _vectors;
ENTRY(_stext)

SECTIONS
{
    /DISCARD/ : {
        *(.note.gnu.build-id)
    }

    .vectors : {
        _stext = ABSOLUTE(.);
        . = ALIGN(512);
        KEEP(*(.vectors))
        . = . + 4;
    } > psram

    .retm_data : {
        . = ALIGN(4);
        __rw_retm_data_start__ = .;
        *(.*l1_ret_text_*)
        *(.*l1_ret_rodata_*)
        *flash_table.c.o    (.text* .rodata*)
        *bf0_hal_mpi.c.o    (.text* .rodata*)
        *bf0_hal_mpi_ex.c.o (.text* .rodata*)
        *bf0_hal_mpi_psram.c.o (.text* .rodata*)
        *flash.c.o          (.text* .rodata*)
        *drv_psram.c.o      (.text* .rodata*)
        *context_gcc.c.o    (.text* .rodata*)
        *drv_common.c.o     (.text.HAL_GetTick)
        *bf0_hal_rcc.c.o    (.text* .rodata*)
        *bf0_pm.c.o         (.text.sifli_light_handler)
        *bf0_pm.c.o         (.text.sifli_deep_handler)
        *bf0_pm.c.o         (.text.sifli_standby_handler)
        *bf0_pm.c.o         (.text.SystemInitFromStandby)
        *.c.o                 (.text.SystemPowerOnModeGet)
        *bf0_hal_gpio.c.o   (.text* .rodata*)
        *bf0_hal_hpaon.c.o  (.text* .rodata*)
        *bf0_hal.c.o        (.text.HAL_Init)
        *.c.o                 (.text.HAL_Delay_us)
        *.c.o                 (.text.HAL_Delay_us_)
        *.c.o                 (.text.HAL_MspInit)
        *bf0_hal_pinmux.c.o (.text* .rodata*)
        *bf0_pin_const.c.o  (.text* .rodata*)
        *drv_common.c.o     (.text.rt_hw_us_delay)
        *.c.o                 (.text.rt_memset)
        *.c.o                 (.text.memset)
        *(.retm_data_*)
        . = ALIGN(4);
        __rw_retm_data_end__ = .;
    } > retention_ram AT > psram

    .retm_bss : {
        . = ALIGN(4);
        __rw_retm_bss_start__ = .;
        __RW_IRAM_RET$$ZI_start__ = .;
        *(.bss.retm_bss_*)
        *idle.c.o(.bss.idle_thread_stack)
        *.o(.bss.bf0_psram_handle)
        . = ALIGN(4);
        __RW_IRAM_RET$$ZI_end__ = .;
    } > retention_ram

    .text : {
        . = ALIGN(512);
        KEEP(*(.vectors))
        . = ALIGN(4);
        *(.text .text.*)
        *(.fixup)
        *(.gnu.warning)
        *(.rodata .rodata.*)
        *(.gnu.linkonce.t.*)
        *(.glue_7)
        *(.glue_7t)
        *(.got)
        *(.gcc_except_table)
        *(.gnu.linkonce.r.*)
        KEEP(*(.init))
        KEEP(*(.fini))

        . = ALIGN(4);
        __fsymtab_start = .;
        KEEP(*(FSymTab))
        __fsymtab_end = .;

        . = ALIGN(4);
        __vsymtab_start = .;
        KEEP(*(VSymTab))
        __vsymtab_end = .;

        . = ALIGN(4);
        __rt_utest_tc_tab_start = .;
        KEEP(*(UtestTcTab))
        __rt_utest_tc_tab_end = .;

        . = ALIGN(4);
        __rt_init_start = .;
        KEEP(*(SORT(.rti_fn*)))
        __rt_init_end = .;

        . = ALIGN(4);
        __sifli_reg_start__ = .;
        KEEP(*(SORT(.sifli_reg*)))
        __sifli_reg_end__ = .;

        . = ALIGN(4);
        __bt_sifli_reg_start__ = .;
        KEEP(*(SORT(.bt_sifli_reg*)))
        __bt_sifli_reg_end__ = .;

        . = ALIGN(4);
        __rtmsymtab_start = .;
        KEEP(*(RTMSymTab))
        __rtmsymtab_end = .;

        . = ALIGN(4);
        LcdDriverDescTab_start = .;
        KEEP(*(LcdDriverDescTab))
        LcdDriverDescTab_end = .;

        . = ALIGN(4);
        __usbh_class_info_start__ = .;
        KEEP(*(.usbh_class_info))
        __usbh_class_info_end__ = .;

        . = ALIGN(4);
        __nand_cfg_db_start__ = .;
        KEEP(*(.nand_cfg_db))
        __nand_cfg_db_end__ = .;

        KEEP(*(.eh_frame*))
        _etext = ABSOLUTE(.);
    } > psram

    .ARM.extab : {
        *(.ARM.extab* .gnu.linkonce.armextab.*)
    } > psram

    __exidx_start = ABSOLUTE(.);
    .ARM.exidx : {
        *(.ARM.exidx* .gnu.linkonce.armexidx.*)
    } > psram
    __exidx_end = ABSOLUTE(.);

    /* CMSIS __copy_table_t: {src, dest, wlen} — wlen is word count (SIZEOF/4) */
    .copy.table : {
        . = ALIGN(4);
        __copy_table_start__ = .;
        LONG (LOADADDR(.data))
        LONG (ADDR(.data))
        LONG (SIZEOF(.data) / 4)
        LONG (LOADADDR(.retm_data))
        LONG (ADDR(.retm_data))
        LONG (SIZEOF(.retm_data) / 4)
        LONG (LOADADDR(.ramfunc))
        LONG (ADDR(.ramfunc))
        LONG (SIZEOF(.ramfunc) / 4)
        __copy_table_end__ = .;
    } > psram

    /* CMSIS __zero_table_t: {dest, wlen} — wlen is word count (SIZEOF/4) */
    .zero.table : {
        . = ALIGN(4);
        __zero_table_start__ = .;
        LONG (__bss_start__)
        LONG ((__bss_end__ - __bss_start__) / 4)
        LONG (ADDR(.retm_bss))
        LONG (SIZEOF(.retm_bss) / 4)
        __zero_table_end__ = .;
    } > psram

    .tdata : {
        _stdata = ABSOLUTE(.);
        *(.tdata .tdata.* .gnu.linkonce.td.*);
        _etdata = ABSOLUTE(.);
    } > psram

    .tbss : {
        _stbss = ABSOLUTE(.);
        *(.tbss .tbss.* .gnu.linkonce.tb.* .tcommon);
        _etbss = ABSOLUTE(.);
    } > psram

    _eronly = ABSOLUTE(.);
    __etext = ALIGN(4);

    .ram_vectors : {
        *(.ram_vectors)
    } > sram

    .data : {
        _sdata = ABSOLUTE(.);
        __data_start__ = .;
        *(vtable)
        *(.data)
        *(.data.*)
        *(.gnu.linkonce.d.*)
        *(.l1_ret_data_*)
        CONSTRUCTORS

        . = ALIGN(4);
        PROVIDE_HIDDEN (__preinit_array_start = .);
        KEEP(*(.preinit_array))
        PROVIDE_HIDDEN (__preinit_array_end = .);

        . = ALIGN(4);
        _sinit = ABSOLUTE(.);
        PROVIDE(__ctors_start__ = .);
        PROVIDE_HIDDEN (__init_array_start = .);
        KEEP(*(SORT(.ctors.*)))
        KEEP(*(.ctors))
        KEEP(*(SORT(.init_array.*)))
        KEEP(*(.init_array))
        _einit = ABSOLUTE(.);
        PROVIDE_HIDDEN (__init_array_end = .);
        PROVIDE(__ctors_end__ = .);

        . = ALIGN(4);
        PROVIDE(__dtors_start__ = .);
        PROVIDE_HIDDEN (__fini_array_start = .);
        KEEP(*(SORT(.dtors.*)))
        KEEP(*(.dtors))
        KEEP(*(SORT(.fini_array.*)))
        KEEP(*(.fini_array))
        PROVIDE_HIDDEN (__fini_array_end = .);
        PROVIDE(__dtors_end__ = .);

        KEEP(*(.jcr*))
        . = ALIGN(4);
        __data_end__ = .;
        _edata = ABSOLUTE(.);
    } > sram AT > psram

    .ramfunc : {
        . = ALIGN(4);
        _sramfunc = ABSOLUTE(.);
        *(.ramfunc .ramfunc.*)
        . = ALIGN(4);
        _eramfunc = ABSOLUTE(.);
    } > sram AT > psram

    _siramfunc = LOADADDR(.ramfunc);

    .bss : {
        . = ALIGN(4);
        _sbss = ABSOLUTE(.);
        __bss_start__ = .;
        *(.bss)
        *(.bss.*)
        *(.gnu.linkonce.b.*)
        *(COMMON)
        . = ALIGN(4);
        __bss_end__ = .;
        _ebss = ABSOLUTE(.);
    } > sram

    . = ALIGN(4);
    __end__ = .;
    PROVIDE(end = .);
    PROVIDE(_end = .);

    .RW_PSRAM1 : {
        . = ALIGN(4);
        __rw_psram1_start__ = .;
        *(.*l2_ret_data_*)
        *(.*l2_ret_bss_*)
        *(.*l2_cache_ret_data_*)
        *(.*l2_cache_ret_bss_*)
        . = ALIGN(4);
        __rw_psram1_end__ = .;
    } > psram

    .RW_PSRAM_NON_RET : {
        . = ALIGN(32);
        __RW_PSRAM_NON_RET_start__ = .;
        *(.nand_cache)
        *(.*l2_cache_non_ret_data_*)
        *(.*l2_cache_non_ret_bss_*)
        . = ALIGN(4);
        __RW_PSRAM_NON_RET_end__ = .;
    } > psram

    .stab 0 : { *(.stab) }
    .stabstr 0 : { *(.stabstr) }
    .stab.excl 0 : { *(.stab.excl) }
    .stab.exclstr 0 : { *(.stab.exclstr) }
    .stab.index 0 : { *(.stab.index) }
    .stab.indexstr 0 : { *(.stab.indexstr) }
    .comment 0 : { *(.comment) }
    .debug_abbrev 0 : { *(.debug_abbrev) }
    .debug_info 0 : { *(.debug_info) }
    .debug_line 0 : { *(.debug_line) }
    .debug_pubnames 0 : { *(.debug_pubnames) }
    .debug_aranges 0 : { *(.debug_aranges) }
}
